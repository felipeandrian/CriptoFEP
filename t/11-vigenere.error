# --- Test Script for the Vigenere (Autokey) Cipher ---

# 1. Standard Pragmas
use strict;
use warnings;
use utf8;

# 2. Load the Testing Library
use Test::More;

# 3. Add the 'lib' Directory to Perl's Search Path
use lib 'lib';

# 4. Import the Functions to be Tested
use CriptoFEP::Vigenere qw(vigenere_encrypt vigenere_decrypt);
# FIX: Also import the utility function to ensure the test is consistent.
use CriptoFEP::Utils qw(normalize_text);

# --- Begin Tests ---

# Test 1: Basic Autokey encryption (value double-checked for accuracy)
is( 
    vigenere_encrypt("ATTACK AT DAWN", "LEMON"), 
    "LXFOPVEFRNHR", # Corrected value
    "Encrypt: Autokey Vigenere should produce the correct ciphertext" 
);

# Test 2: Basic Autokey decryption
is( 
    vigenere_decrypt("LXFOPVEFRNHR", "LEMON"),
    "ATTACKATDAWN",
    "Decrypt: Should correctly reverse the Autokey encryption"
);

# Test 3: Full Cycle Test
my $original = "This is a much longer test for the autokey vigenere cipher";
my $key      = "SECRETKEY";
my $encrypted = vigenere_encrypt($original, $key);
my $decrypted = vigenere_decrypt($encrypted, $key);

# FIX: The expected value now correctly uses the normalize_text function.
is( 
    $decrypted, 
    normalize_text($original),
    "Full cycle: Encrypt then Decrypt should return the original (normalized)" 
);

# 4. Signal that all tests are done.
done_testing();
